
const express = require("express");
const cors = require("cors");

const app = express();

app.use(cors());
app.use(express.json({ limit: "2mb" }));

app.get("/", (req, res) => {
  res.json({
    app: "NOVA AI",
    message: "Backend is running!"
  });
});

app.get("/api/v1/health", (req, res) => {
  res.json({
    status: "ok",
    app: "NOVA AI"
  });
});

app.post("/api/v1/videos/text", (req, res) => {
  const { prompt } = req.body;

  if (!prompt || !prompt.trim()) {
    return res.status(400).json({
      error: "Video prompt is required"
    });
  }

  res.status(501).json({
    error: "AI video provider is not connected yet"
  });
});

app.post("/api/v1/videos/image", (req, res) => {
  res.status(501).json({
    error: "Image-to-video provider is not connected yet"
  });
});

const PORT = process.env.PORT || 3000;

app.listen(PORT, "0.0.0.0", () => {
  console.log(`NOVA AI running on port ${PORT}`);
});
